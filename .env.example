# Chemin vers la base SQLite des utilisateurs
DB_PATH=data/users.db

# ── YOLO (pipeline principal) ─────────────────────────────────────────────────
# Chemin vers le modèle YOLO entraîné (généré par scripts/train.py)
YOLO_MODEL_PATH=models/face_yolo.pt

# Seuil de confiance YOLO (0–1)
CONFIDENCE_THRESHOLD=0.5

# ── DeepFace (fallback si YOLO absent) ───────────────────────────────────────
# Dossier contenant les images de référence
FACES_DB_PATH=data/faces

# Modèle DeepFace : ArcFace | Facenet512 | VGG-Face | DeepID
DEEPFACE_MODEL=ArcFace

# Détecteur : opencv | retinaface | mtcnn | ssd
DEEPFACE_DETECTOR=opencv

# Seuil de distance cosinus (plus bas = plus strict)
RECOGNITION_THRESHOLD=0.68
