# Chemin vers la base SQLite des utilisateurs
DB_PATH=data/users.db

# ── Modèles (pipeline deux étapes) ───────────────────────────────────────────
# Modèle 1 : détecteur de visages (yolov8n-face, téléchargé auto si absent)
DETECTOR_PATH=models/face_detector.pt

# Modèle 2 : classificateur d'identité (entraîné sur Kaggle)
CLASSIFIER_PATH=models/face_classifier.pt

# Seuil de confiance classificateur (0–1)
CONFIDENCE_THRESHOLD=0.5

# ── DeepFace (fallback si YOLO absent) ───────────────────────────────────────
# Dossier contenant les images de référence
FACES_DB_PATH=data/faces

# Modèle DeepFace : ArcFace | Facenet512 | VGG-Face | DeepID
DEEPFACE_MODEL=ArcFace

# Détecteur : retinaface (recommandé) | opencv | mtcnn | yunet
DEEPFACE_DETECTOR=retinaface

# Seuil de distance cosinus (plus bas = plus strict)
RECOGNITION_THRESHOLD=0.68

# ── Webcam live ───────────────────────────────────────────────────────────────
# Analyser 1 frame sur N (5 = bon compromis CPU, 1 = max sur GPU)
WEBCAM_PROCESS_EVERY_N=5
