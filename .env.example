# Chemin vers la base SQLite des utilisateurs
DB_PATH=data/users.db

# ── InsightFace (buffalo_l — RetinaFace + ArcFace ResNet50) ──────────────────
# Dossier contenant les images de référence (1 photo par personne minimum)
FACES_DB_PATH=data/faces

# Seuil de similarité cosinus ArcFace (0–1) — plus haut = plus strict
# 0.45 : bon équilibre  |  0.55 : strict  |  0.35 : permissif
RECOGNITION_THRESHOLD=0.45

# ── Webcam live ───────────────────────────────────────────────────────────────
# Analyser 1 frame sur N (5 = bon compromis CPU, 1 = max sur GPU)
WEBCAM_PROCESS_EVERY_N=5
